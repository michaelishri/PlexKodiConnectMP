<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.plexkodiconnect.ms" name="PlexKodiConnect (Multi-Server) Repository" version="1.0.1" provider-name="michaelishri">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="PlexKodiConnect Multi-Server Repository">
    <!-- Bump this add-on's version when changing paths to force a repo refresh. -->
    <dir>
      <info compressed="false">https://michaelishri.github.io/PlexKodiConnectMP/repo/addons.xml</info>
      <checksum>https://michaelishri.github.io/PlexKodiConnectMP/repo/addons.xml.md5</checksum>
      <datadir>https://michaelishri.github.io/PlexKodiConnectMP/repo/bin</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">PlexKodiConnect Multi-Server Addon Repository</summary>
    <description lang="en_GB">Repository for the multi-server fork of PlexKodiConnect and its dependency addons.</description>
    <disclaimer lang="en_GB">This is a fork. Disable or uninstall the official PlexKodiConnect addon before using it, since both write to the same Kodi database.</disclaimer>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <website>https://github.com/michaelishri/PlexKodiConnectMP</website>
    <source>https://github.com/michaelishri/PlexKodiConnectMP</source>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
