<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.plexkodiconnect.ms" name="PlexKodiConnect (Multi-Server) Repository" version="1.0.0" provider-name="michaelishri">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="PlexKodiConnect Multi-Server Repository">
    <info compressed="false">https://michaelishri.github.io/PlexKodiConnectMP/repo/addons.xml</info>
    <checksum>https://michaelishri.github.io/PlexKodiConnectMP/repo/addons.xml.md5</checksum>
    <datadir zip="true">https://michaelishri.github.io/PlexKodiConnectMP/repo/bin/</datadir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>PlexKodiConnect Multi-Server Addon Repository</summary>
    <description>Repository for the multi-server fork of PlexKodiConnect and its dependency addons.</description>
    <disclaimer>This is a fork. Disable or uninstall the official PlexKodiConnect addon before using it, since both write to the same Kodi database.</disclaimer>
    <platform>all</platform>
  </extension>
</addon>
